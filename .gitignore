__pycache__/
*.pyc
artifacts/
.venv/
MUJOCO_LOG.TXT
config.local.json
.env
build/
dist/
*.egg-info/

# Local state and release preparation inputs
.env.*
!.env.example
.loop/
*.sqlite
*.sqlite-*
credentials.json
*.pem
*.key

# Generated test and MuJoCo files
.pytest_cache/
/mjmodel.mjb
reference/

# User projects: generated scripts, device records and data never ship.
/user_projects/

# User-authored packages and unreviewed tools stay local.
/skills/
/user_skills/
/user_tools/
/toolchain/candidates/

# Root is also the Python package: only maintained modules may be staged.
/*.py
!/__init__.py
!/__main__.py
!/_version.py
!/install_support.py
!/launcher.py
!/model_switch.py
!/release_client.py
!/release_runtime.py

# Local device inspection script, not an approved distribution tool.
/scripts/inspect_jetson_ssh.py

# Only these maintained default Skill templates belong to the distribution.
/configs/skills/*
!/configs/skills/isaac-scene-builder/
!/configs/skills/mujoco-scene-builder/
!/configs/skills/simulation-learning-data/
/configs/skills/isaac-scene-builder/*
/configs/skills/mujoco-scene-builder/*
/configs/skills/simulation-learning-data/*
!/configs/skills/isaac-scene-builder/SKILL.md
!/configs/skills/mujoco-scene-builder/SKILL.md
!/configs/skills/simulation-learning-data/SKILL.md

# Root documentation is an entry point, not storage for user operation reports.
/*.md
!/AGENTS.md
!/README.md
!/README.zh-CN.md
